generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm powers fuzzy board search; both are contrib extensions in the pgvector image.
  extensions = [vector, pg_trgm]
}

// What a moderator may do beyond being staff. An owner holds all of these implicitly, by the
// check short-circuiting on the role rather than by being granted the set.
enum StaffPermission {
  MOVE_ENTRIES
  EDIT_ENTRIES
  HANDLE_REPORTS
  WRITE_NOTES
  MANAGE_THEMES
  // Who may read the board, and the gates on suggesting and upvoting.
  //
  // Its own permission rather than part of MODERATE, because the two are not the same power: a
  // moderator arriving by invite link should be able to run the queue without being able to open
  // the board to the whole internet. A creator who wants to delegate it grants it explicitly.
  MANAGE_POLICY
}

enum StaffRole {
  OWNER
  MOD
}

enum ViewVisibility {
  PUBLIC
  ANY_PATREON_USER
  SUBSCRIBERS_ONLY
}

enum MediaType {
  MOVIE
  TV
  // A TMDB collection is another kind of canonical identity, so a franchise is a Title like any
  // other and reuses de-duplication, the catalogue cache and the board projection unchanged.
  COLLECTION
}

enum AliasKind {
  OFFICIAL
  ROMAJI
  NATIVE
  ALTERNATIVE
}

enum RecommendationType {
  MOVIE
  SHOW
  FRANCHISE
  WATCH_ORDER
  EXTERNAL_LINK
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  ACTIVE
  COMPLETED
  REJECTED
  DELETED
}

enum NoteKind {
  NOTE
  TIMELINE
}

enum StrikeReason {
  RATE_LIMIT
  MODERATION_BLOCK
  UPHELD_FLAG
  DUPLICATE_FLOOD
}

enum RelationKind {
  SEASON_OF
  SEQUEL
  PREQUEL
  SAME_FRANCHISE
  RELATED
}

enum OfferKind {
  FLATRATE
  FREE
  ADS
  RENT
  BUY
}

enum FlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum FlagReason {
  SPAM
  HARASSMENT
  SEXUAL_CONTENT
  OFF_TOPIC
  DUPLICATE
  OTHER
}

enum ModerationActionType {
  EDIT
  DELETE
  RESTORE
  STATUS_CHANGE
  FLAG_RESOLVED
  FLAG_DISMISSED
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  patreonUserId          String    @unique
  fullName               String?
  email                  String?
  avatarUrl              String?
  accessTokenEncrypted   String?
  refreshTokenEncrypted  String?
  tokenExpiresAt         DateTime?
  // When the staleness job last *attempted* this user, success or not. Ordering on it stops a
  // permanently failing user from occupying the batch forever and starving everyone else.
  membershipsRefreshedAt DateTime?
  // We owe this reader a membership sync, and no stale Membership row will remind us.
  //
  // Set when login could not read their memberships — Patreon's identity endpoint times out for
  // readers with many of them. For somebody who has signed in before that is harmless, because
  // their existing rows go stale and the refresh job finds them anyway. For somebody whose
  // *first* login failed it is the only trace: they have no memberships at all, so a job that
  // selects on a stale one would never look at them again.
  //
  // A column rather than widening that selector to "everyone with no memberships", which is most
  // people and would have the job re-asking Patreon about them forever.
  membershipsSyncPending Boolean   @default(false)
  // Amendment A.2: premium buys granularity, never notification itself. Added unset and gated
  // closed on purpose — the column costs nothing now, and adding it later would mean taking
  // granularity away from people who already had it.
  premiumUntil           DateTime?
  // Off for everybody, including accounts that already exist. The address came from Patreon's
  // OAuth for signing in, and sending a digest to it is a different purpose from the one it was
  // handed over for — not something a default should settle.
  emailDigest            Boolean   @default(false)
  // The watermark. Moves only when a provider accepted the message, so a failed send leaves
  // today's news in tomorrow's digest rather than losing it.
  lastDigestAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  ownedCreators           Creator[]                     @relation("CreatorOwner")
  memberships             Membership[]
  notificationPreferences BoardNotificationPreference[]
  carryOverDeliveries     CarryOverDelivery[]
  boardViewPreferences    BoardViewPreference[]
  entryFollows            EntryFollow[]
  subscription            Subscription?
  paymentReceipts         PaymentReceipt[]
  staffRoles              CreatorStaff[]                @relation("StaffMember")
  staffAssigned           CreatorStaff[]                @relation("StaffAssigner")
  recommendations         Recommendation[]
  upvotes                 Upvote[]
  abuseRecord             AbuseRecord?
  notesWritten            CreatorNote[]                 @relation("NoteAuthor")
  invitesSent             StaffInvite[]                 @relation("InviteAuthor")
  invitesAccepted         StaffInvite[]                 @relation("InviteAcceptor")
  notifications           Notification[]
  moderationResults       ModerationResult[]
  favorites               CreatorFavorite[]
  ticketsRaised           Ticket[]                      @relation("TicketAuthor")
  ticketsResolved         Ticket[]                      @relation("TicketResolver")
  flagsRaised             Flag[]                        @relation("FlagAuthor")
  flagsResolved           Flag[]                        @relation("FlagResolver")
  moderationActs          ModerationAction[]            @relation("ModerationActor")
  Reaction                Reaction[]
  RecommendationLink      RecommendationLink[]
  tokenBalances           TokenBalance[]
  tokenLedger             TokenLedger[]
  redeems                 Redeem[]
}

model AbuseRecord {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @unique @db.Uuid
  strikeCount  Int           @default(0)
  // Null when never timed out. Left in place once it lapses, so the history stays readable.
  timeoutUntil DateTime?
  lastStrikeAt DateTime?
  // Why the most recent strike was earned. For operators reading the table, never for the user:
  // design §9 wants no probing of the rules.
  lastReason   StrikeReason?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The decay job walks the quietest first.
  @@index([lastStrikeAt])
  @@index([timeoutUntil])
}

model Creator {
  id                     String    @id @default(uuid()) @db.Uuid
  patreonCampaignId      String    @unique
  ownerUserId            String    @db.Uuid
  displayName            String
  slug                   String    @unique
  // The creator's own site, registered at claim time for the Phase 4 extension.
  baseUrl                String?
  // Patreon issues one webhook secret per webhook, and a webhook belongs to one campaign — so
  // the secret is per creator, never global. Encrypted at rest like the OAuth tokens.
  webhookSecretEncrypted String?
  // Ordering key for tier re-sync, so every creator is reached rather than the first N by id.
  tiersSyncedAt          DateTime?
  claimedAt              DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  owner               User                          @relation("CreatorOwner", fields: [ownerUserId], references: [id])
  tiers               Tier[]
  memberships         Membership[]
  staff               CreatorStaff[]
  policy              CreatorPolicy?
  recommendations     Recommendation[]
  themes              Theme[]
  themeSources        ThemeSource[]
  notifications       Notification[]
  moderationResults   ModerationResult[]
  blockwords          CreatorBlockword[]
  tickets             Ticket[]
  favoritedBy         CreatorFavorite[]
  notificationPrefs   BoardNotificationPreference[]
  carryOverDeliveries CarryOverDelivery[]
  boardViewPrefs      BoardViewPreference[]
  staffInvites        StaffInvite[]
  tokenBalances       TokenBalance[]
  tokenLedger         TokenLedger[]
  redeems             Redeem[]

  // Postgres does not index foreign keys automatically, and the cascade from Creator scans them.
  @@index([ownerUserId])
}

model Tier {
  id              String   @id @default(uuid()) @db.Uuid
  creatorId       String   @db.Uuid
  patreonTierId   String
  title           String
  amountCents     Int
  // What an upvote from this tier is worth. One until a creator says otherwise, so a board that
  // never touches this ranks by headcount exactly as it did before.
  voteWeight      Int      @default(1)
  // Redeem tokens granted to this tier's members per period. Zero until the creator sets it, so
  // enabling the feature grants nothing by itself.
  tokensPerPeriod Int      @default(0)
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator        Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  upvotes        Upvote[]
  submitPolicies CreatorPolicy[] @relation("SubmitMinTier")
  upvotePolicies CreatorPolicy[] @relation("UpvoteMinTier")
  tokenLedger    TokenLedger[]

  @@unique([creatorId, patreonTierId])
  @@index([creatorId])
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  creatorId      String   @db.Uuid
  currentTierId  String?  @db.Uuid
  amountCents    Int      @default(0)
  isActivePatron Boolean  @default(false)
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator     Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  currentTier Tier?   @relation(fields: [currentTierId], references: [id])

  @@unique([userId, creatorId])
  // The unique index above only serves a userId prefix; creator-scoped lookups need their own.
  @@index([creatorId])
  @@index([currentTierId])
}

model CreatorStaff {
  id               String            @id @default(uuid()) @db.Uuid
  creatorId        String            @db.Uuid
  userId           String            @db.Uuid
  role             StaffRole
  // Empty for a new moderator: a permission absent from this set is denied, so a permission
  // added in future is denied to every existing mod until an owner grants it. An OWNER row's
  // contents are ignored — the check short-circuits on the role.
  permissions      StaffPermission[]
  assignedByUserId String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  creator    Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user       User    @relation("StaffMember", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("StaffAssigner", fields: [assignedByUserId], references: [id])

  // One row per person per creator: moderation power derives only from this row, so a duplicate
  // would make "is this user staff?" ambiguous.
  @@unique([creatorId, userId])
  @@index([creatorId])
  @@index([userId])
  @@index([assignedByUserId])
}

model StaffInvite {
  id               String    @id @default(uuid()) @db.Uuid
  creatorId        String    @db.Uuid
  // SHA-256 of the opaque token. The plaintext is returned once and never stored, so a database
  // read cannot recover a live invite — the rule the session token already follows.
  tokenHash        String    @unique
  role             StaffRole
  invitedByUserId  String    @db.Uuid
  expiresAt        DateTime
  // Set when consumed. Single-use: an invite that could be replayed is a standing credential.
  acceptedAt       DateTime?
  acceptedByUserId String?   @db.Uuid
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  creator    Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InviteAuthor", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("InviteAcceptor", fields: [acceptedByUserId], references: [id])

  @@index([creatorId])
  @@index([expiresAt])
  @@index([invitedByUserId])
  @@index([acceptedByUserId])
}

model CreatorPolicy {
  id                    String         @id @default(uuid()) @db.Uuid
  creatorId             String         @unique @db.Uuid
  // Subscribers only, deliberately, and this default is a security decision rather than a taste
  // one. A public board publishes what a creator is currently watching, and that list is being
  // scraped to file fraudulent DMCA claims against them. Defaulting to public made every new
  // creator a target before they had chosen anything.
  //
  // ANY_PATREON_USER is no safer against that: a Patreon account is free, so it costs an
  // automated reader nothing. Only SUBSCRIBERS_ONLY puts a price on looking.
  //
  // A creator who wants an open board still gets one — in two clicks, having been told what it
  // exposes. The opposite mistake is silent.
  viewVisibility        ViewVisibility @default(SUBSCRIBERS_ONLY)
  submitMinTierId       String?        @db.Uuid
  upvoteMinTierId       String?        @db.Uuid
  hidePendingFromPublic Boolean        @default(false)
  // Redeemable tokens are off for every board until its creator turns them on, so a board that
  // never hears of the feature behaves exactly as it did before it existed.
  redeemTokensEnabled   Boolean        @default(false)
  // Whether a patron may lift votes cast at a cheaper tier to their current one. On by default:
  // paying more, even once, is not meant to be taken back. A creator who wants the board to
  // reflect current support rather than historical generosity turns it off.
  allowVoteRatchet      Boolean        @default(true)
  // Off by default: a public contact form on a public board is the highest-value spam target
  // in the app. A creator who wants messages from anyone turns it on.
  allowAnonymousTickets Boolean        @default(false)
  // On by default: opt-in would strand the feature at zero reach, and a carried-over entry is
  // labelled and lands in the review queue like anything else. A creator who does not want other
  // people's lists arriving on their board turns it off here.
  acceptsCarryOver      Boolean        @default(true)
  // On by default: a quality-of-life feature is opt-out. A board that wants no emoji on it is
  // the creator's call.
  allowReactions        Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  creator       Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  // Restrict, not SetNull: nulling a gate does not disable it, it drops the requirement to
  // "any active patron", so deleting a tier would silently widen access. Plan 04's tier re-sync
  // now has to decide explicitly what happens to a gated tier.
  submitMinTier Tier?   @relation("SubmitMinTier", fields: [submitMinTierId], references: [id], onDelete: Restrict)
  upvoteMinTier Tier?   @relation("UpvoteMinTier", fields: [upvoteMinTierId], references: [id], onDelete: Restrict)

  @@index([submitMinTierId])
  @@index([upvoteMinTierId])
}

model Recommendation {
  id                String               @id @default(uuid()) @db.Uuid
  // The creator's own shortlist, floated to the top of its column whatever the sort. A filter
  // would make a reader ask for it; this makes the answer visible without being asked.
  isCreatorPick     Boolean              @default(false)
  // Arrived by somebody carrying their list across boards rather than by a person choosing this
  // board. Labelled so moderators can judge a class of them at once, and so a creator who turns
  // carry-over off can tell what it was doing.
  viaCarryOver      Boolean              @default(false)
  carriedTo         CarryOverDelivery[]  @relation("CarriedFrom")
  followers         EntryFollow[]
  // What the board ranks by. Denormalised like upvoteCount beside it, and for the same reason:
  // it is the sort key, and a keyset cursor has to compare a column.
  weightedScore     Int                  @default(0)
  // Stored rather than counted on read, for the reason `weightedScore` is: the board orders on
  // this and pages by keyset, and ordering by an aggregate over a joined table makes the cursor
  // meaningless. Maintained in the same transaction as every spend and every consume.
  unconsumedRedeems Int                  @default(0)
  // The entry this one is grouped under, chosen by staff. Distinct from the nesting the board
  // derives from TMDB collections: that is keyed on titleId and cannot express a decision, nor
  // reach an external link, which has no title at all.
  //
  // SetNull, not Cascade: deleting a head releases its children rather than taking them with it.
  // Grouping preserves — that is what separates it from a merge.
  groupHeadId       String?              @db.Uuid
  // Where staff placed this card by hand, used only by the `manual` sort. Fractional so that
  // inserting between two cards writes one row rather than renumbering the column. Highest
  // first, so placing something at the top does not touch anything below it.
  manualRank        Float?
  creatorId         String               @db.Uuid
  submittedByUserId String               @db.Uuid
  type              RecommendationType
  customTitle       String
  // Lowercased, punctuation-stripped form used for de-duplication of EXTERNAL_LINK entries.
  // TMDB-bound entries de-duplicate on titleId instead — see the partial unique indexes.
  normalizedTitle   String
  // Set when the entry is bound to a canonical catalogue title.
  titleId           String?              @db.Uuid
  description       String?
  notes             String?
  status            RecommendationStatus @default(PENDING)
  // Denormalized so the board does not count rows per entry on every read (design §5).
  upvoteCount       Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  creator         Creator              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  submittedBy     User                 @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)
  title           Title?               @relation(fields: [titleId], references: [id])
  links           RecommendationLink[]
  watchOrderItems WatchOrderItem[]
  tickets         Ticket[]
  reactions       Reaction[]
  groupHead       Recommendation?      @relation("EntryGroup", fields: [groupHeadId], references: [id], onDelete: SetNull)
  groupMembers    Recommendation[]     @relation("EntryGroup")
  upvotes         Upvote[]
  flags           Flag[]
  actions         ModerationAction[]
  // `notes` is already a scalar on this model (the submitter's own free text from Plan 05), so
  // the relation carries the model's name instead.
  creatorNotes    CreatorNote[]
  redeems         Redeem[]

  // De-duplication is enforced here, not by the read-then-write check: two concurrent
  // submissions of the same title both miss that read.
  @@unique([creatorId, normalizedTitle])
  // status sits between the equality column and the sort columns, so an index leading with it
  // cannot be walked in sort order — the board fell back to sorting the creator's whole table.
  // This one matches the ORDER BY exactly.
  @@index([creatorId, upvoteCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  // The review queue reads one creator's entries oldest-first, including the statuses the board
  // index's consumers never ask for.
  @@index([creatorId, createdAt])
  // Trigram search. Declared so `migrate dev` cannot propose dropping what the migration made.
  @@index([normalizedTitle(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([submittedByUserId])
}

enum LinkStatus {
  CANDIDATE
  PUBLISHED
}

model RecommendationLink {
  id                String     @id @default(uuid()) @db.Uuid
  recommendationId  String     @db.Uuid
  url               String
  label             String?
  // Design §4: a URL from a non-staff submitter waits for a human. Otherwise submitting a
  // duplicate is a way to attach a link to any card on any public board, where it renders with
  // the creator's implicit endorsement — and a URL is actionable in a way a title is not.
  status            LinkStatus @default(CANDIDATE)
  // The identity of the page, with the parts that only say *where it was found* removed. Two
  // people submitting the same page from different countries submit one candidate.
  canonicalUrl      String
  submittedByUserId String?    @db.Uuid
  // Where the creator has decided to watch it. Locking one stops new candidates queueing behind
  // a decision already made.
  isPreferred       Boolean    @default(false)
  createdAt         DateTime   @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  submittedBy    User?          @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)

  // One row per page per entry, whatever form it arrived in.
  @@unique([recommendationId, canonicalUrl])
  @@index([recommendationId])
  @@index([submittedByUserId])
}

model WatchOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  recommendationId String   @db.Uuid
  // Normalised to 0..n-1 on write. A client-supplied position is not trusted: a duplicated or
  // sparse one renders an order nobody can read.
  position         Int
  // Bound to the catalogue when TMDB knows the entry, free text when it does not — "and then the
  // fan edit" has to be expressible. Exactly one of the two is set.
  titleId          String?  @db.Uuid
  customTitle      String?
  note             String?
  createdAt        DateTime @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  title          Title?         @relation(fields: [titleId], references: [id])

  @@unique([recommendationId, position])
  @@index([recommendationId])
  @@index([titleId])
}

model Upvote {
  id               String   @id @default(uuid()) @db.Uuid
  recommendationId String   @db.Uuid
  userId           String   @db.Uuid
  // The tier held when the vote was cast — a reference, never a copied number, so a creator
  // rebalancing changes what votes already cast are worth. Null is a voter with no tier, which
  // counts as one: a board that lets them vote is letting them vote.
  tierId           String?  @db.Uuid
  createdAt        DateTime @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, not SetNull: a tier with votes against it is not deletable, because dropping the
  // reference would silently reprice every vote cast at it.
  tier           Tier?          @relation(fields: [tierId], references: [id], onDelete: Restrict)

  // Design §5: one upvote per person per entry.
  @@unique([recommendationId, userId])
  @@index([userId])
  // A rebalance recomputes from these, grouped by tier.
  @@index([tierId])
}

model CreatorNote {
  id               String    @id @default(uuid()) @db.Uuid
  recommendationId String    @db.Uuid
  authorUserId     String    @db.Uuid
  kind             NoteKind
  body             String
  // Only meaningful on a TIMELINE note: "we'll cover this in March". Nullable because "soon, no
  // promises" is a legitimate thing to say, and requiring a date would make creators invent one.
  plannedFor       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  // Restrict, like ModerationAction: deleting a moderator's account must not erase what they
  reactions      Reaction[]
  // wrote on someone else's board.
  author         User           @relation("NoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([recommendationId, createdAt])
  @@index([authorUserId])
}

model Flag {
  id               String     @id @default(uuid()) @db.Uuid
  recommendationId String     @db.Uuid
  flaggedByUserId  String     @db.Uuid
  reason           FlagReason
  note             String?
  status           FlagStatus @default(OPEN)
  resolvedByUserId String?    @db.Uuid
  resolvedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  flaggedBy      User           @relation("FlagAuthor", fields: [flaggedByUserId], references: [id], onDelete: Cascade)
  resolvedBy     User?          @relation("FlagResolver", fields: [resolvedByUserId], references: [id])

  // One flag per person per entry: flag count is a moderation priority signal (design §6.6), and
  // without this it measures one user's persistence rather than several users' agreement.
  @@unique([recommendationId, flaggedByUserId])
  @@index([recommendationId])
  @@index([flaggedByUserId])
  @@index([resolvedByUserId])
}

model ModerationAction {
  id               String               @id @default(uuid()) @db.Uuid
  recommendationId String               @db.Uuid
  actorUserId      String               @db.Uuid
  action           ModerationActionType
  note             String?
  // Before/after snapshots of the fields the action touched (design §3). Json rather than
  // columns: the shape differs per action type, and an audit row is never queried by field.
  before           Json?
  after            Json?
  createdAt        DateTime             @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  // No cascade from the actor: deleting a moderator's account must not erase the record of what
  // they did. This is the one relation in the schema where the audit outlives the user.
  actor          User           @relation("ModerationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([recommendationId, createdAt(sort: Desc)])
  @@index([actorUserId])
}

model Title {
  id         String    @id @default(uuid()) @db.Uuid
  tmdbId     Int
  mediaType  MediaType
  name       String
  year       Int?
  posterPath String?
  overview   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // When the relation/theme builder last *attempted* this title. Ordering on it stops a
  // permanently failing title from occupying the batch forever.
  enrichedAt      DateTime?
  /// Which model produced the `embedding` column (added in raw SQL — Prisma has no vector type).
  /// Compared against the configured model so a rotation re-embeds, rather than leaving two
  /// incomparable vector spaces in one column with nothing to notice it.
  embeddingModel  String?
  embeddedAt      DateTime?
  aliases         TitleAlias[]
  recommendations Recommendation[]
  availability    StreamingAvailability[]
  watchOrderItems WatchOrderItem[]
  relationsFrom   TitleRelation[]         @relation("RelationFrom")
  relationsTo     TitleRelation[]         @relation("RelationTo")
  themes          TitleTheme[]

  // TMDB ids are only unique within a media type: film 123 and series 123 are different works.
  @@unique([tmdbId, mediaType])
  // The enrichment job walks the un-enriched oldest first.
  @@index([enrichedAt])
  // The embedding job walks rows with no vector or a stale model.
  @@index([embeddingModel])
}

model StreamingAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  titleId   String   @db.Uuid
  // ISO-3166-1 alpha-2. An availability answer without its region answers the wrong question for
  // every patron outside it.
  region    String   @db.VarChar(2)
  // The upstream's own watch page for this title and region. Null when it offers none.
  link      String?
  // Denormalized offers: read whole, never queried by field, and the shape is the provider's.
  offers    Json
  // When the upstream was last *asked* — not when the row last changed. Staleness is a property
  // of the question, so an unchanged refresh still moves it forward and the row stops being
  // retried on every pass.
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([titleId, region])
  // The refresh job walks the oldest first, across every title and region.
  @@index([fetchedAt])
}

model TitleRelation {
  id        String       @id @default(uuid()) @db.Uuid
  // Direction matters: from the member to the container for SEASON_OF and SAME_FRANCHISE.
  // Storing both ways would double the rows and let them disagree.
  fromId    String       @db.Uuid
  toId      String       @db.Uuid
  kind      RelationKind
  // TMDB's own ordering within a collection or season list, for rendering.
  ordinal   Int?
  createdAt DateTime     @default(now())

  from Title @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Title @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  // Idempotent by construction: re-running the builder cannot multiply rows.
  @@unique([fromId, toId, kind])
  @@index([fromId])
  @@index([toId])
}

model Theme {
  id        String   @id @default(uuid()) @db.Uuid
  creatorId String   @db.Uuid
  // What the creator calls it. Seeded from TMDB, then theirs to rename.
  name      String
  // Lowercased name for uniqueness: two themes differing only in case are one theme.
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  titles  TitleTheme[]
  sources ThemeSource[]

  @@unique([creatorId, slug])
  @@index([creatorId])
}

// The TMDB labels a theme answers to, so re-seeding matches the source rather than the display
// name — otherwise every pass would resurrect a theme the creator renamed or merged away.
//
// Many labels per theme, because that is what a merge produces: fold "sci-fi" into "science
// fiction" and the survivor legitimately owns both.
// A reader's own shortlist. Deliberate, unlike a membership — which is a side effect of paying
// for something — so it outranks one when boards are ordered.
model CreatorFavorite {
  userId    String   @db.Uuid
  creatorId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([userId, creatorId])
  @@index([creatorId])
}

// How much of a followed board's news a reader wants.
//
// An absent row means the default; an empty `statuses` array means silence. They are different
// answers and must stay distinguishable: collapse them and "I want nothing from this board" reads
// identically to "I have not chosen", so any later change to the default silently un-silences
// everyone who had asked for quiet.
model BoardNotificationPreference {
  userId    String                 @db.Uuid
  creatorId String                 @db.Uuid
  statuses  RecommendationStatus[]
  // Which of this board's themes the reader wants to hear about. Empty means all of them, which
  // is a different answer from the empty `statuses` above meaning silence — narrowing by theme is
  // something you opt into, while choosing no columns is choosing nothing.
  //
  // Themes rather than a set of the reader's own: they already exist per board, are already
  // attached to titles, and a private vocabulary would need its own model and its own upkeep.
  // The cost is real and is stated where the filter is applied — an entry with no catalogue title
  // carries no themes at all.
  themeIds  String[]               @db.Uuid
  updatedAt DateTime               @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([userId, creatorId])
  @@index([creatorId])
}

// "Tell me about this one."
//
// The thing themes cannot express: they are TMDB genres and keywords, and somebody waiting on a
// particular show is naming a title, not a category.
//
// The entry rather than the title it points at, because the notification is about something
// moving on a *board* and a title is shared across boards. De-duplication means a resubmission
// resolves to the same entry, so the row survives somebody suggesting it again.
model EntryFollow {
  userId           String   @db.Uuid
  recommendationId String   @db.Uuid
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@id([userId, recommendationId])
  // The fan-out asks "who follows this entry" on every move.
  @@index([recommendationId])
}

// How one reader has arranged one board for themselves.
//
// Kept apart from BoardNotificationPreference because they answer different questions and change
// at completely different rates: this one moves every time somebody folds a column, that one when
// they sit down and decide what they want to hear about.
//
// `sorts` is Json rather than columns because the set of columns is the lifecycle enum and a
// column per status would need a migration every time that grows. The DTO validates on the way
// in, which is the only place a bad value can be caught.
model BoardViewPreference {
  userId    String                 @db.Uuid
  creatorId String                 @db.Uuid
  collapsed RecommendationStatus[]
  sorts     Json                   @default("{}")
  updatedAt DateTime               @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([userId, creatorId])
  @@index([creatorId])
}

// Where a subscription stands with the provider.
//
// REFUNDED is kept apart from CANCELLED because they mean opposite things about the money:
// cancelling stops the next renewal and leaves the month already paid for intact, while a refund
// takes the money back and the entitlement goes with it.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  REFUNDED
}

// One reader's standing with the payment provider.
//
// Deliberately holds no personal data: the provider is the merchant of record and keeps the name,
// the address and the card. What is here is their identifier for the subscription, their
// identifier for the customer, and what state it is in — enough to answer "is this reader
// premium" and nothing a regulator would call personal.
//
// `User.premiumUntil` is a projection of this, not a second source of truth. Five gates read that
// column already; pointing them all at this table instead would be five call sites and five
// chances to disagree.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  // One per reader: two would make "are they premium" a question with two answers.
  userId                 String             @unique @db.Uuid
  provider               String
  providerSubscriptionId String             @unique
  providerCustomerId     String
  // The order this subscription was created by.
  //
  // Stored because a refund arrives as an *order* event and the order payload carries no
  // subscription id — subscriptions have an `order_id`, not the other way round. Without this
  // there is no way back from "this order was refunded" to "revoke that entitlement".
  //
  // Nullable: rows written before this existed have no order recorded, and a refund of one of
  // those cannot be matched. They are reconciled instead, when their period runs out.
  providerOrderId        String?
  status                 SubscriptionStatus
  // What has been paid for. Entitlement runs to here, plus a grace window when a payment failed.
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The reconciliation job reads the ones whose period has run out without a renewal.
  @@index([status, currentPeriodEnd])
  // A refund arrives naming the order, and this is the only way back to the subscription.
  @@index([providerOrderId])
}

// One row per webhook the provider has already delivered.
//
// Providers retry on any non-2xx and on a timeout, so the same event arrives more than once as a
// matter of course rather than as a fault. Without this, a retry after a slow response extends a
// subscription a second time — and the slower we are, the more likely it is.
// What an account paid, and nothing about who they are.
//
// A merchant of record holds the name, the email address, the billing address and the card. This
// row holds the provider's own references and the amount, which is everything needed to show
// somebody their payment history and to send them to the real receipt — and nothing that would
// turn a demo database into somebody's billing record.
//
// Deliberately absent: name, email, postal address, card brand, last four, payment processor.
model PaymentReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String
  // The provider's reference for the charge. Unique with the provider, which is what makes
  // writing one idempotent under webhook redelivery.
  providerReceiptId String
  // The order it belongs to, so a refund can be shown against the payment it reverses.
  providerOrderId   String?
  amountCents       Int
  // ISO-4217.
  currency          String   @db.VarChar(3)
  paidAt            DateTime
  // Where the provider hosts the real one. Null for a provider that hosts none.
  url               String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerReceiptId])
  // The reader's own history, newest first. Total order: two receipts can share a paidAt.
  @@index([userId, paidAt, id])
}

// An address this application must stop writing to.
//
// Mailbox providers judge a sender on whether it keeps mailing people who bounced or complained,
// and suspend the ones that do. The list is therefore about the sending domain's standing rather
// than about any one reader — which is why it is enforced in the sender rather than in the digest,
// so every future email path inherits it without having to remember.
//
// Keyed on the address, lowercased, because that is all a bounce names. Deliberately not a
// relation to User: an address can bounce before anybody owns it, and can outlive the account.
model EmailSuppression {
  // Lowercased on the way in. Addresses are case-insensitive in the part that routes them, and a
  // list that misses "Ada@example.com" because it stored "ada@example.com" protects nothing.
  address   String            @id
  reason    SuppressionReason
  // The provider's own explanation, kept for when somebody asks why they stopped receiving mail.
  detail    String?
  createdAt DateTime          @default(now())

  @@index([createdAt])
}

enum SuppressionReason {
  // The receiving server rejected it permanently. A temporary bounce is not this — a full mailbox
  // is not a wrong address, and suppressing on one loses a reader who did nothing.
  BOUNCED
  // They marked it as spam. The most expensive signal there is; never mail them again.
  COMPLAINED
}

model ProcessedWebhookEvent {
  // The provider's own event id, so the uniqueness is theirs rather than something we derive.
  id         String   @id
  provider   String
  eventType  String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// How a carried-over suggestion ended up.
//
// `PENDING` is also what a delivery goes back to when the board's own rate limit is reached: the
// creator's limit is theirs, so the queue waits at it rather than pushing past it, and burning
// the delivery on a 429 would make the feature quietly lossy.
enum CarryOverOutcome {
  PENDING
  SUBMITTED
  ALREADY_PRESENT
  REFUSED_BEFORE
  NOT_ELIGIBLE
  NOT_ACCEPTED
  FAILED
}

// One title, on its way to one board, on behalf of one reader.
//
// Unique on the three together so re-broadcasting a list is idempotent rather than additive — and
// so this row is the single place the outcome is reported back from.
model CarryOverDelivery {
  id                     String           @id @default(uuid()) @db.Uuid
  userId                 String           @db.Uuid
  creatorId              String           @db.Uuid
  sourceRecommendationId String           @db.Uuid
  outcome                CarryOverOutcome @default(PENDING)
  // What it landed on, whether newly created or already there — the one-click upvote needs it.
  resultRecommendationId String?          @db.Uuid
  detail                 String?
  createdAt              DateTime         @default(now())
  processedAt            DateTime?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  // Cascades: what is being carried is the source entry, so if the reader deletes it there is
  // nothing left to deliver. A plain id with no foreign key would leave deliveries pointing at
  // rows that no longer exist, and nothing would notice — the same reasoning the Reaction model
  // carries for not using a polymorphic pair.
  source  Recommendation @relation("CarriedFrom", fields: [sourceRecommendationId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId, sourceRecommendationId])
  // The drain reads the oldest waiting deliveries first.
  @@index([outcome, createdAt])
}

// Enthusiasm, kept apart from demand. Never an input to any ordering — the moment a reaction
// could move an entry it would be a second voting system, with none of the tier weighting that
// makes the first one meaningful, and one anybody could flood.
//
// Two nullable subjects rather than a polymorphic (type, id) pair: a polymorphic pair carries no
// foreign key, so deleting an entry would leave orphaned reactions and nothing would notice. A
// check constraint keeps exactly one set. Comments get a third column when they arrive.
model Reaction {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  recommendationId String?  @db.Uuid
  noteId           String?  @db.Uuid
  emote            String
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  note           CreatorNote?    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  // One of each emote per person per subject; sending it again takes it back.
  @@unique([recommendationId, userId, emote])
  @@unique([noteId, userId, emote])
  @@index([recommendationId])
  @@index([noteId])
  @@index([userId])
}

enum TicketStatus {
  OPEN
  RESOLVED
}

// What staff decided. Recorded even when the reply deliberately says nothing —
// "handled internally" is a legitimate answer to a reader, and not one to the audit trail.
enum TicketResolution {
  CONFIRMED
  DENIED
  LINKED
  CLOSED
}

// A message from a reader to staff. A dispute and general contact differ by what the message
// points at, not by which table it lives in — two tables would mean two inboxes, two
// notification types, and two sets of resolution logic to drift apart.
model Ticket {
  id               String            @id @default(uuid()) @db.Uuid
  creatorId        String            @db.Uuid
  // Null for someone not signed in, which a creator must opt into accepting.
  raisedByUserId   String?           @db.Uuid
  // The entry this is about, if any. SetNull rather than Cascade: a ticket outlives the entry
  // it disputes, and the reader's own words are the substance.
  subjectId        String?           @db.Uuid
  body             String
  status           TicketStatus      @default(OPEN)
  resolution       TicketResolution?
  reply            String?
  resolvedByUserId String?           @db.Uuid
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  creator    Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  raisedBy   User?           @relation("TicketAuthor", fields: [raisedByUserId], references: [id], onDelete: SetNull)
  subject    Recommendation? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  resolvedBy User?           @relation("TicketResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  // The inbox reads open tickets for one board, oldest first, so nothing rots.
  @@index([creatorId, status, createdAt])
  @@index([subjectId])
  @@index([raisedByUserId])
}

enum BlockwordAction {
  BLOCK
  FLAG
}

// Design §6.5(a): the per-creator half of the wordlist stage. The global `obscenity` list handles
// profanity everywhere; this is a board's own terms — a spoiler, a handle, a running joke that
// stopped being funny.
model CreatorBlockword {
  id        String          @id @default(uuid()) @db.Uuid
  creatorId String          @db.Uuid
  // Stored normalised (trimmed, lowercased): it is matched, never displayed back as typed.
  pattern   String
  action    BlockwordAction @default(BLOCK)
  createdAt DateTime        @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, pattern])
}

enum ModerationSubjectType {
  RECOMMENDATION
  NOTE
  THEME
  FLAG_NOTE
}

// Design §6.5: the pipeline's verdicts, kept. Only FLAG and BLOCK are written — every submission,
// note and rename passes through the pipeline and almost all of them pass, so recording those
// would be the largest table in the database holding nothing anyone reads.
//
// The offending text is deliberately absent. A BLOCK on a slur would otherwise mean the database
// keeps that slur for ever, on a row nobody reads, for a board that never accepted it — and §6.6
// gives moderators redaction precisely so text like that can be removed.
model ModerationResult {
  id          String                @id @default(uuid()) @db.Uuid
  creatorId   String                @db.Uuid
  userId      String                @db.Uuid
  subjectType ModerationSubjectType
  // Null when the content was rejected outright: there is nothing to point at, and that is
  // exactly the case where the record matters, since it is the evidence behind an abuse strike.
  subjectId   String?               @db.Uuid
  verdict     String
  categories  String[]
  source      String
  createdAt   DateTime              @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt(sort: Desc)])
  @@index([subjectId])
}

enum NotificationType {
  ENTRY_STATUS_CHANGED
  ENTRY_FLAGGED
  // Something moved on a board you follow. Deliberately distinct from ENTRY_STATUS_CHANGED, which
  // answers "your entry moved": the submitter must not receive both for one move.
  ENTRY_MOVED
  // The entry you spent a token on is playing. Distinct from ENTRY_MOVED for the same reason
  // that one is distinct from ENTRY_STATUS_CHANGED: a redeemer who also follows the board must
  // receive one notification for the move, not two.
  REDEEM_PLAYING
  TICKET_RAISED
  TICKET_RESOLVED
}

// Design §3: in-app only — §12 puts email and push out of Phase 1, and every provider worth
// using costs money.
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  // Kept so a board's notifications go when the board does, and so the SPA can link back.
  creatorId  String           @db.Uuid
  type       NotificationType
  // A snapshot, not a join: the message has to keep being true after the entry it describes is
  // deleted, retitled by a moderator, or moved somewhere this reader can no longer see.
  payload    Json
  // Ranked at write time rather than derived from the payload on every sort: a report about
  // harassment wants working before one about a duplicate, and ordering on a column is something
  // an index can serve. Zero for anything that is news rather than a problem.
  severity   Int              @default(0)
  // How many events this row now stands for. A creator tidying eight entries into Now Playing is
  // one act, not eight pieces of news — see `emitCoalesced`. One means exactly what it says.
  groupCount Int              @default(1)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, severity(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  // Serves the coalescing lookup: everyone on this board with one of these still unread. Without
  // it that read is a sequential scan on every move of every entry.
  @@index([creatorId, type, readAt])
}

model ThemeSource {
  creatorId String @db.Uuid
  sourceKey String
  themeId   String @db.Uuid

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([creatorId, sourceKey])
  @@index([themeId])
}

model TitleTheme {
  titleId String @db.Uuid
  themeId String @db.Uuid

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([titleId, themeId])
  @@index([themeId])
}

model TitleAlias {
  id        String    @id @default(uuid()) @db.Uuid
  titleId   String    @db.Uuid
  language  String
  kind      AliasKind
  text      String
  createdAt DateTime  @default(now())

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([titleId, language, kind, text])
  @@index([titleId])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// What a reader has left to spend on one creator's board.
///
/// A cache of the ledger's sum, not a second truth: every write updates both in one transaction.
/// Stored because the board reads a balance on every load, and summing a ledger that grows every
/// month is a scan that gets slower forever.
model TokenBalance {
  id        String   @id @default(uuid()) @db.Uuid
  creatorId String   @db.Uuid
  userId    String   @db.Uuid
  available Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([creatorId, userId])
}

enum TokenLedgerKind {
  TIER_GRANT
  CREATOR_GRANT
  SPEND
}

/// Every movement of a token, so a balance can always be explained.
///
/// A number nobody can account for is a number nobody can argue with: when a patron says "I had
/// three", the answer has to be rows.
model TokenLedger {
  id        String          @id @default(uuid()) @db.Uuid
  creatorId String          @db.Uuid
  userId    String          @db.Uuid
  kind      TokenLedgerKind
  /// Positive for a grant, negative for a spend, so the column sums to the balance.
  amount    Int
  /// Set on TIER_GRANT only, with periodKey — together they are what makes granting idempotent.
  tierId    String?         @db.Uuid
  periodKey String?
  /// Set on CREATOR_GRANT: why the creator gave these, in their own words.
  reason    String?
  redeemId  String?         @db.Uuid
  createdAt DateTime        @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier    Tier?   @relation(fields: [tierId], references: [id], onDelete: SetNull)
  redeem  Redeem? @relation(fields: [redeemId], references: [id], onDelete: SetNull)

  /// The idempotency guarantee, in the database rather than in a service that has to remember to
  /// check. Membership sync runs on webhooks, on a refresh job and on sign-in, and is
  /// transactional with none of them — so a grant that is merely *usually* run once is a grant
  /// that will one day run twice.
  ///
  /// Deliberately keyed on the period and NOT the tier. Including `tierId` lets a reader who
  /// upgrades mid-period be granted again, because the new tier makes a new key — measured at
  /// 1 + 3 = 4 tokens for one month, which is a patron upgrading and downgrading to mint them.
  @@unique([creatorId, userId, periodKey])
  @@index([creatorId, userId, createdAt])
}

/// One token spent on one entry, with what the spender wants played.
///
/// The note is free text rather than a catalogue reference: nothing here models an episode, so
/// "S2E04" is a sentence the creator reads rather than a row the system resolves.
model Redeem {
  id               String    @id @default(uuid()) @db.Uuid
  creatorId        String    @db.Uuid
  recommendationId String    @db.Uuid
  userId           String    @db.Uuid
  note             String
  /// Set when the entry reached ACTIVE. A consumed redeem is never returned to a balance.
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  creator        Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger         TokenLedger[]

  /// The board counts unconsumed redeems per entry on every load.
  @@index([recommendationId, consumedAt])
  @@index([creatorId, userId])
}
