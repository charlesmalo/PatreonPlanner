NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://planner:planner@localhost:5432/planner
REDIS_URL=redis://localhost:6379

# Only if the default host ports are already taken. Keep DATABASE_URL/REDIS_URL in sync.
# POSTGRES_PORT=5433
# REDIS_PORT=6380

# From https://www.patreon.com/portal/registration/register-clients
PATREON_CLIENT_ID=replace-me
PATREON_CLIENT_SECRET=replace-me
PATREON_REDIRECT_URI=http://localhost:3000/auth/patreon/callback

# Encrypts Patreon tokens at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me

# Optional: without it, catalogue search and mainstream submissions are refused while
# EXTERNAL_LINK submissions keep working.
# TMDB_API_KEY=replace-me

SESSION_TTL_SECONDS=1209600
WEB_ORIGIN=http://localhost:5173
