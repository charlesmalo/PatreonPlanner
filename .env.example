NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://planner:planner@localhost:5432/planner
REDIS_URL=redis://localhost:6379

# Only if the default host ports are already taken. Keep DATABASE_URL/REDIS_URL in sync.
# POSTGRES_PORT=5433
# REDIS_PORT=6380

# From https://www.patreon.com/portal/registration/register-clients
PATREON_CLIENT_ID=replace-me
PATREON_CLIENT_SECRET=replace-me
PATREON_REDIRECT_URI=http://localhost:3000/auth/patreon/callback

# Encrypts Patreon tokens at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me

# Optional: without it, catalogue search and mainstream submissions are refused while
# EXTERNAL_LINK submissions keep working.
# 
# --- Semantic search (optional; free, runs a local model in-process) ---
# Costs ~250-400MB resident and downloads the model on first use.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# --- Request limiting ---
# How many proxies sit in front of the API. Wrong in either direction is silent: too high and a
# client can forge its address via X-Forwarded-For; too low and per-IP limiting switches off
# rather than bucketing the whole internet together. Behind one nginx or one platform load
# balancer, this is 1.
TRUSTED_PROXY_HOPS=0
COARSE_LIMIT_BURST=60
COARSE_LIMIT_PER_MINUTE=120
SEARCH_LIMIT_BURST=30
SEARCH_LIMIT_PER_MINUTE=60
SEARCH_SIMILARITY_THRESHOLD=0.3
AVAILABILITY_REGION_DEFAULT=US
AVAILABILITY_TTL_HOURS=24
AVAILABILITY_REGIONS=US,GB,CA,AU,IE,NZ,DE,FR,ES,IT,JP,BR,MX
TMDB_API_KEY=replace-me

SESSION_TTL_SECONDS=1209600
WEB_ORIGIN=http://localhost:5173
